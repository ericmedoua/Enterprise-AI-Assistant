apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: enterprise-ai
type: Opaque
stringData:
  DATABASE_URL: "postgresql://postgres:YOUR_DATABASE_PASSWORD@postgres-service:5432/enterprise_ai_db"
  DATABASE_PASSWORD: "YOUR_DATABASE_PASSWORD"
  JWT_SECRET_KEY: "REPLACE_WITH_A_LONG_RANDOM_SECRET"
  GROQ_API_KEY: "REPLACE_WITH_YOUR_GROQ_API_KEY"
